# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloud_ide
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cloud_ide
DB_POOL_MAX=20
DB_TIMEOUT_MS=10000

# Redis Configuration (Optional / Graceful Fallback)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
REDIS_TTL_SECONDS=3600

# Authentication & Session Security
SESSION_SECRET=super_secret_session_key_change_in_production_min_32_chars
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE_MS=86400000

# Docker Code Execution Engine
DOCKER_ENABLED=true
DOCKER_NETWORK_MODE=none
DOCKER_MEM_LIMIT=256m
DOCKER_CPUS=0.5
DOCKER_PIDS_LIMIT=64
EXECUTION_TIMEOUT_MS=10000

# Resource & Payload Constraints
MAX_CODE_SIZE_BYTES=65536
MAX_STDIN_SIZE_BYTES=65536
MAX_OUTPUT_SIZE_BYTES=262144

# Docker Images
DOCKER_IMAGE_PYTHON=python:3.11-slim
DOCKER_IMAGE_CPP=gcc:13.2
DOCKER_IMAGE_JAVA=eclipse-temurin:17-jdk-alpine
